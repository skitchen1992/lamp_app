# Copy this file to .env and replace all change-me values before deployment.

SERVICE_BIND_ADDRESS=127.0.0.1
DATABASE_BIND_ADDRESS=127.0.0.1

GATEWAY_SERVICE_PORT=8000

# These ports are useful for local Poetry runs. Docker Compose publishes only
# the API Gateway; domain services stay inside the compose network.
AUTH_SERVICE_PORT=8003
PRODUCT_SERVICE_PORT=8001
ORDER_SERVICE_PORT=8002

AUTH_DATABASE_HOST=localhost
AUTH_DATABASE_PORT=5435
AUTH_DATABASE_HOST_PORT=5435
AUTH_DATABASE_NAME=auth_db
AUTH_DATABASE_USER=auth_user
AUTH_DATABASE_PASSWORD=change-me-auth-password
AUTH_ACCESS_TOKEN_SECRET=change-me-auth-access-token-secret

PRODUCT_DATABASE_HOST=localhost
PRODUCT_DATABASE_PORT=5433
PRODUCT_DATABASE_HOST_PORT=5433
PRODUCT_DATABASE_NAME=product_db
PRODUCT_DATABASE_USER=product_user
PRODUCT_DATABASE_PASSWORD=change-me-product-password

ORDER_DATABASE_HOST=localhost
ORDER_DATABASE_PORT=5434
ORDER_DATABASE_HOST_PORT=5434
ORDER_DATABASE_NAME=order_db
ORDER_DATABASE_USER=order_user
ORDER_DATABASE_PASSWORD=change-me-order-password
ORDER_PRODUCT_SERVICE_URL=http://localhost:8000

GATEWAY_AUTH_SERVICE_URL=http://localhost:8003
GATEWAY_PRODUCT_SERVICE_URL=http://localhost:8001
GATEWAY_ORDER_SERVICE_URL=http://localhost:8002

# Optional full DSN overrides. Leave these unset unless your deployment platform
# already provides database URLs directly.
# AUTH_DATABASE_URL=postgresql://auth_user:change-me-auth-password@localhost:5435/auth_db
# PRODUCT_DATABASE_URL=postgresql://product_user:change-me-product-password@localhost:5433/product_db
# ORDER_DATABASE_URL=postgresql://order_user:change-me-order-password@localhost:5434/order_db
